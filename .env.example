# =============================================================================
# Danse 2 Vivre — variables d'environnement
# Copier ce fichier en .env.local et REMPLIR avec les vraies valeurs.
# NE JAMAIS commiter .env, .env.local, ni aucune valeur sensible.
# =============================================================================

# ---- Supabase (projet existant fkutafmumvzzeyeeakxt — ne pas en créer un autre)
NEXT_PUBLIC_SUPABASE_URL=https://hgndfwjsyukamkcvubsf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (jamais NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# ---- AWS S3 (bucket existant danse-2-vivre — ne pas en créer un autre)
AWS_REGION=eu-west-3
S3_BUCKET=danse-2-vivre

# Server-only — CREDENTIALS AWS jamais côté navigateur
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Limites upload (server-only)
S3_MAX_UPLOAD_BYTES=10485760
S3_ALLOWED_MIME=image/jpeg,image/png,image/webp

# ---- App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

