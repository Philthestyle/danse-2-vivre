# ---- Supabase (projet existant fkutafmumvzzeyeeakxt — ne pas en créer un autre)
NEXT_PUBLIC_SUPABASE_URL=https://hgndfwjsyukamkcvubsf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (jamais NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Uploads Supabase Storage (bucket "media", créé via scripts/setup-storage-bucket.mjs)
# Limites appliquées côté route /api/s3/presign
S3_MAX_UPLOAD_BYTES=10485760
S3_ALLOWED_MIME=image/jpeg,image/png,image/webp

# ---- App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

